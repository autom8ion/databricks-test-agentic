# Databricks workspace connection (see: https://docs.databricks.com/dev-tools/databricks-connect.html)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Compute target: set DATABRICKS_SERVERLESS=1 to use serverless compute,
# or set DATABRICKS_CLUSTER_ID to target a specific cluster. Pick one.
DATABRICKS_SERVERLESS=1
# DATABRICKS_CLUSTER_ID=0123-456789-abcdefgh

# Catalog/schema the test suite is allowed to write into: scratch tables,
# plus the seeded customers/orders/order_items sample structure
# (see src/dbx_tests/sample_data.py). "main" is a common Unity Catalog
# default but not universal - if tests fail with NO_SUCH_CATALOG_EXCEPTION,
# run `SHOW CATALOGS` against your workspace and use one you can write to
# (often "workspace").
DBX_TEST_CATALOG=main
DBX_TEST_SCHEMA=default
